20b", "outcome": "granted", "detail": {"waited_s": 0.0}}, {"name": "call:draft", "start_ms": 282.4, "end_ms": 1018.3, "model": "openai/gpt-oss-20b", "outcome": "200:ok", "detail": {}}, {"name": "check", "start_ms": 1018.3, "end_ms": 1019.1, "model": null, "outcome": "pass", "detail": {"gate_ok": true, "failures": 0, "verifier": null}}, {"name": "verify", "start_ms": 1018.9, "end_ms": 1019.1, "model": null, "outcome": "skipped (no headroom)", "detail": {}}, {"name": "send", "start_ms": 1019.1, "end_ms": 1019.1, "model": null, "outcome": "answer", "detail": {}}], "checks": {"gate": {"ok": true, "sentences": 1, "failures": []}, "verifier": null, "draft_model": "openai/gpt-oss-20b", "attempts": 1, "router": {"papers": ["dynamic_chunking"], "query": "dynamic chunking segmentation boundary detection byte stream hierarchical How does H-Net decide where to cut the byte stream into pieces?", "alt_query": "learning to split sequences chunking strategy variable length segments end-to-end How does H-Net decide where to cut the byte stream into pieces?"}, "retrieval": {"query": "dynamic chunking segmentation boundary detection byte stream hierarchical How does H-Net decide where to cut the byte stream into pieces?", "papers": ["dynamic_chunking"], "k": 3, "pids": ["dynamic_chunking:2400:0004", "dynamic_chunking:2400:0002", "dynamic_chunking:2400:0028"]}}, "released_ms": 1019.1, "budget_wait_ms": 0.2, "tokens_in": 1932, "tokens_out": 132, "level_name": "full (other model)", "pipeline_model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 233, "completion_tokens": 60, "tokens_estimated": false, "ms": 279.7578000026988, "waited_s": 0.0}, {"step": "draft", "model": "openai/gpt-oss-20b", "status": 200, "outcome": "ok", "prompt_tokens": 1699, "completion_tokens": 72, "tokens_estimated": false, "ms": 735.6093999987934, "waited_s": 0.0}]}}
{"type": "answer", "run_id": "burst-20261110T183141Z", "scenario": "burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q15", "request_id": "burst-20261110T183141Z-0015", "start_time": "2026-11-10T18:32:04.375+00:00", "arrival_offset_s": 23.123, "patience_s": 22.0, "gave_up": false, "waited_ms": 4.1, "degraded": true, "reply": {"request_id": "burst-20261110T183141Z-0015", "question": "Why the ratio loss, and what are F, G and N?", "kind": "passages", "level": 3, "text": "No written answer this time: here are the most relevant passages from the papers, quoted as they are. A written answer should be possible in about 16 s.\n[S1] 2507.07955v2 p.8 §2.2.3: \"Inspired by load balancing mechanisms in Mixture-of-Experts (MoE) models (Fedus, Zoph, and Shazeer 2022), which face similar challenges in maintaining balanced expert utilization, we introduce a ratio loss to guide compression: L_ratio = N N− 1 ((N − 1)FG +(1−F)(1−G)), F = 1 L ∑︁^L t =1 b_t, G = 1 L ∑︁^L t =1 p_t, (10) whereF represents the fraction of vectors actually selected,G denotes the average boundary probability, andN controls the target compression ratio.\"\n[S2] 2507.07955v2 p.16 §3.2: \"Experimental setup for Chinese and code. On Chinese and code, we use 46B token subset from FineWeb-Edu-Chinese- V2.1 (Yu, Dai, et al. 2025) and Github subset from Pile (Gao, Biderman, et al. 2020) to train three models at the 1.3B GPT-3 XL scale: H-Net (2-stage), H-Net (space), and Transformer. We maintain the same bytes per gradient step (256 batch size with 8192 utf-8 encoded bytes per example) as the main text experiments. For the H-Net (2-stage), we use the same target downsampling ratio (N^0 =N^1 = 3) as the main experiments.\"", "sources": [{"sid": "S1", "cite": "2507.07955v2 p.8 §2.2.3", "pid": "dynamic_chunking:2400:0015", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p08-b006", "dynamic_chunking-p08-b007", "dynamic_chunking-p08-b008", "dynamic_chunking-p08-b009", "dynamic_chunking-p08-b010", "dynamic_chunking-p08-b011", "dynamic_chunking-p08-b012", "dynamic_chunking-p08-b013", "dynamic_chunking-p08-b014", "dynamic_chunking-p08-b015", "dynamic_chunking-p08-b016", "dynamic_chunking-p08-b017", "dynamic_chunking-p08-b018", "dynamic_chunking-p08-b019", "dynamic_chunking-p08-b020", "dynamic_chunking-p08-b021", "dynamic_chunking-p08-b022"]}, {"sid": "S2", "cite": "2507.07955v2 p.16 §3.2", "pid": "dynamic_chunking:2400:0030", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p16-b003", "dynamic_chunking-p16-b004"]}], "notice": "passages only, no model call: no drafter free within 8 s", "eta_s": 16.0, "model_calls": [], "spans": [{"name": "plan", "start_ms": 0.0, "end_ms": 0.8, "model": null, "outcome": "passages", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 35.06470230000559, "openai/gpt-oss-20b": 20.08005480000429, "qwen/qwen3.8-27b": 55.66100000000006}, "lean": {"openai/gpt-oss-120b": 31.03720230000181, "openai/gpt-oss-20b": 15.977554800003418, "qwen/qwen3.8-27b": 55.66100000000006}}, "drafter": null}}, {"name": "retrieve", "start_ms": 0.8, "end_ms": 1.2, "model": null, "outcome": "1 search", "detail": {"query": "Why the ratio loss, and what are F, G and N?", "papers": null, "k": 2, "evidence": {"best": 1.0, "union": 1.0, "top_bm25": 20.122, "query_terms": 5}}}, {"name": "send", "start_ms": 3.2, "end_ms": 3.2, "model": null, "outcome": "passages", "detail": {}}], "checks": {}, "released_ms": 3.2, "budget_wait_ms": 0, "tokens_in": 0, "tokens_out": 0, "level_name": "passages", "pipeline_model_calls": []}}
{"type": "answer", "run_id": "burst-20261110T183141Z", "scenario": "burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q9", "request_id": "burst-20261110T183141Z-0016", "start_time": "2026-11-10T18:32:05.068+00:00", "arrival_offset_s": 23.821, "patience_s": 92.49, "gave_up": false, "waited_ms": 3.2, "degraded": true, "reply": {"request_id": "burst-20261110T183141Z-0016", "question": "What makes Moshi full-duplex, and how does it handle both sides speaking at once?", "kind": "passages", "level": 3, "text": "No written answer this time: here are the most relevant passages from the papers, quoted as they are. A written answer should be possible in about 14 s.\n[S1] 2410.00037v1 p.5 §2: \"Spoken Dialogue Models. Spoken dialogue is one of the less explored tasks in speech generation, as it requires addressing several challenges: 1) The model should run in real time and allow for long conversations in full-duplex—the model always listens and can speak at any moment; 2) it should be speech-to-speech to handle paralinguistic communication; 3) it should display knowledge and reasoning abilities that make it amenable to helpful and enjoyable conversations.\"\n[S2] 2410.00037v1 pp.6-7 §3.1: \"Moshi is a multi-stream speech-to-speech Transformer model, which allows for full-duplex spoken dialogue with a user thanks to an innovative architecture summarized in Figure 1. Moshi is built on top of Helium, a text LLM which we build from scratch (Section 3.2), relying on high-quality text data to provide strong reasoning abilities to the model. We also propose Inner Monologue (Section 3.4.4), a training and inference procedure in which we jointly model text and audio tokens.\"", "sources": [{"sid": "S1", "cite": "2410.00037v1 p.5 §2", "pid": "moshi:2400:0007", "paper": "moshi", "block_ids": ["moshi-p05-b001", "moshi-p05-b002"]}, {"sid": "S2", "cite": "2410.00037v1 pp.6-7 §3.1", "pid": "moshi:2400:0009", "paper": "moshi", "block_ids": ["moshi-p06-b005", "moshi-p07-b001", "moshi-p07-b002"]}], "notice": "passages only, no model call: no drafter free within 8 s", "eta_s": 14.3, "model_calls": [], "spans": [{"name": "plan", "start_ms": 0.0, "end_ms": 0.9, "model": null, "outcome": "passages", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 33.01170230000571, "openai/gpt-oss-20b": 17.997054799998295, "qwen/qwen3.8-27b": 54.97299999999814}, "lean": {"openai/gpt-oss-120b": 29.344202300002507, "openai/gpt-oss-20b": 14.277054800004407, "qwen/qwen3.8-27b": 54.97299999999814}}, "drafter": null}}, {"name": "retrieve", "start_ms": 1.0, "end_ms": 1.4, "model": null, "outcome": "1 search", "detail": {"query": "What makes Moshi full-duplex, and how does it handle both sides speaking at once?", "papers": null, "k": 2, "evidence": {"best": 0.936, "union": 1.0, "top_bm25": 22.943, "query_terms": 8}}}, {"name": "send", "start_ms": 2.9, "end_ms": 2.9, "model": null, "outcome": "passages", "detail": {}}], "checks": {}, "released_ms": 2.9, "budget_wait_ms": 0, "tokens_in": 0, "tokens_out": 0, "level_name": "passages", "pipeline_model_calls": []}}
{"type": "answer", "run_id": "burst-20261110T183141Z", "scenario": "burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q3", "request_id": "burst-20261110T183141Z-0017", "start_time": "2026-11-10T18:32:05.335+00:00", "arrival_offset_s": 24.076, "patience_s": 21.26, "gave_up": false, "waited_ms": 3.3, "degraded": true, "reply": {"request_id": "burst-20261110T183141Z-0017", "question": "How are the positional encodings built, and why sinusoids rather than learned embeddings?", "kind": "passages", "level": 3, "text": "No written answer this time: here are the most relevant passages from the papers, quoted as they are. A written answer should be possible in about 14 s.\n[S1] 1706.03762v7 p.6 §3.5: \"To this end, we add \"positional encodings\" to the input embeddings at the bottoms of the encoder and decoder stacks. The positional encodings have the same dimension d_model as the embeddings, so that the two can be summed. There are many choices of positional encodings, learned and fixed [9]. In this work, we use sine and cosine functions of different frequencies: P E_(pos,2i) = sin(pos/10000^2i/d_model) P E_(pos,2i+1) = cos(pos/10000^2i/d_model) where pos is the position and i is the dimension. That is, each dimension of the positional encoding corresponds to a sinusoid.\"\n[S2] 1706.03762v7 pp.8-9 §6.2: \"In Table 3 rows (B), we observe that reducing the attention key size d_k hurts model quality. This suggests that determining compatibility is not easy and that a more sophisticated compatibility function than dot product may be beneficial. We further observe in rows (C) and (D) that, as expected, bigger models are better, and dropout is very helpful in avoiding over-fitting. In row (E) we replace our sinusoidal positional encoding with learned positional embeddings [9], and observe nearly identical results to the base model.\"", "sources": [{"sid": "S1", "cite": "1706.03762v7 p.6 §3.5", "pid": "attention:2400:0011", "paper": "attention", "block_ids": ["attention-p06-b004", "attention-p06-b005", "attention-p06-b006", "attention-p06-b007", "attention-p06-b008", "attention-p06-b009"]}, {"sid": "S2", "cite": "1706.03762v7 pp.8-9 §6.2", "pid": "attention:2400:0020", "paper": "attention", "block_ids": ["attention-p08-b012", "attention-p08-b013", "attention-p09-b001", "attention-p09-b002", "attention-p09-b003", "attention-p09-b004", "attention-p09-b005"]}], "notice": "passages only, no model call: no drafter free within 8 s", "eta_s": 14.3, "model_calls": [], "spans": [{"name": "plan", "start_ms": 0.0, "end_ms": 0.9, "model": null, "outcome": "passages", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 31.63670230000571, "openai/gpt-oss-20b": 16.614554800005862, "qwen/qwen3.8-27b": 54.70799999999872}, "lean": {"openai/gpt-oss-120b": 29.416702300004545, "openai/gpt-oss-20b": 14.349554799999169, "qwen/qwen3.8-27b": 54.70799999999872}}, "drafter": null}}, {"name": "retrieve", "start_ms": 0.9, "end_ms": 1.2, "model": null, "outcome": "1 search", "detail": {"query": "How are the positional encodings built, and why sinusoids rather than learned embeddings?", "papers": null, "k": 2, "evidence": {"best": 0.719, "union": 0.719, "top_bm25": 24.008, "query_terms": 7}}}, {"name": "send", "start_ms": 3.0, "end_ms": 3.0, "model": null, "outcome": "passages", "detail": {}}], "checks": {}, "released_ms": 3.0, "budget_wait_ms": 0, "tokens_in": 0, "tokens_out": 0, "level_name": "passages", "pipeline_model_calls": []}}
{"type": "answer", "run_id": "burst-20261110T183141Z", "scenario": "burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q8", "request_id": "burst-20261110T183141Z-0002", "start_time": "2026-11-10T18:32:02.121+00:00", "arrival_offset_s": 20.871, "patience_s": 19.64, "gave_up": false, "waited_ms": 3242.3, "degraded": false, "reply": {"request_id": "burst-20261110T183141Z-0002", "question": "What are Moshi's main components and what does each do?", "kind": "answer", "level": 0, "text": "Moshi’s architecture is built around three core components: the Helium text‑language‑model backbone, the Mimi neural audio codec, and the streaming Depth Transformer that jointly processes two audio streams and time‑aligned text tokens [S2]. Helium supplies strong reasoning and linguistic knowledge to the system by providing pre‑trained text tokens that are used as prefixes for semantic generation, thereby improving factuality and linguistic quality during dialogue [S1][S2]. Mimi encodes raw audio into discrete acoustic tokens using residual vector quantization and distills semantic information into the first token level, enabling the model to synthesize intelligible, high‑quality speech directly from its predictions without a separate TTS stage [S1][S3]. The Depth Transformer, designed for streaming inference, hierarchically generates semantic and acoustic tokens for both the user and Moshi while aligning text tokens via the Inner Monologue procedure, allowing full‑duplex, real‑time spoken dialogue without explicit speaker‑turn modeling [S1][S3].", "sources": [{"sid": "S1", "cite": "2410.00037v1 pp.6-7 §3.1", "pid": "moshi:2400:0009", "paper": "moshi", "block_ids": ["moshi-p06-b005", "moshi-p07-b001", "moshi-p07-b002"]}, {"sid": "S2", "cite": "2410.00037v1 p.6 §2", "pid": "moshi:2400:0008", "paper": "moshi", "block_ids": ["moshi-p06-b001", "moshi-p06-b002"]}, {"sid": "S3", "cite": "2410.00037v1 p.3 §1", "pid": "moshi:2400:0003", "paper": "moshi", "block_ids": ["moshi-p03-b003", "moshi-p03-b004", "moshi-p03-b005", "moshi-p03-b006", "moshi-p03-b007", "moshi-p03-b008"]}], "notice": "checked for citations only (no second-model check)", "eta_s": null, "model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 231, "completion_tokens": 82}, {"step": "draft", "model": "openai/gpt-oss-120b", "status": 200, "outcome": "ok", "prompt_tokens": 1751, "completion_tokens": 347}], "spans": [{"name": "plan", "start_ms": 0.0, "end_ms": 0.7, "model": null, "outcome": "full", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 0.0, "openai/gpt-oss-20b": 0.0, "qwen/qwen3.8-27b": 0.0}}, "drafter": "openai/gpt-oss-120b"}}, {"name": "understand", "start_ms": 0.7, "end_ms": 360.3, "model": null, "outcome": "router", "detail": {}}, {"name": "wait:understand", "start_ms": 0.7, "end_ms": 0.7, "model": "qwen/qwen3.8-27b", "outcome": "granted", "detail": {"waited_s": 0.0}}, {"name": "call:understand", "start_ms": 0.8, "end_ms": 360.3, "model": "qwen/qwen3.8-27b", "outcome": "200:ok", "detail": {}}, {"name": "retrieve", "start_ms": 360.4, "end_ms": 360.9, "model": null, "outcome": "1 search", "detail": {"query": "Moshi architecture Inner Monologue Time Extended Transformer TTT Residual Vector Quantization RVQ streaming autoregressive What are Moshi's main components and what does each do?", "papers": ["moshi"], "k": 3, "evidence": {"best": 1.0, "union": 1.0, "top_bm25": 28.523, "query_terms": 5}}}, {"name": "decide", "start_ms": 360.9, "end_ms": 361.0, "model": null, "outcome": "draft", "detail": {"best": 1.0, "union": 1.0, "top_bm25": 28.523, "query_terms": 5}}, {"name": "draft", "start_ms": 361.0, "end_ms": 3240.2, "model": null, "outcome": "openai/gpt-oss-120b", "detail": {"level": "full"}}, {"name": "wait:draft", "start_ms": 361.0, "end_ms": 361.1, "model": "openai/gpt-oss-120b", "outcome": "granted", "detail": {"waited_s": 0.0}}, {"name": "call:draft", "start_ms": 361.1, "end_ms": 3240.2, "model": "openai/gpt-oss-120b", "outcome": "200:ok", "detail": {}}, {"name": "check", "start_ms": 3240.3, "end_ms": 3241.5, "model": null, "outcome": "pass", "detail": {"gate_ok": true, "failures": 0, "verifier": null}}, {"name": "verify", "start_ms": 3241.3, "end_ms": 3241.5, "model": null, "outcome": "skipped (no headroom)", "detail": {}}, {"name": "send", "start_ms": 3241.6, "end_ms": 3241.6, "model": null, "outcome": "answer", "detail": {}}], "checks": {"gate": {"ok": true, "sentences": 4, "failures": []}, "verifier": null, "draft_model": "openai/gpt-oss-120b", "attempts": 1, "router": {"papers": ["moshi"], "query": "Moshi architecture Inner Monologue Time Extended Transformer TTT Residual Vector Quantization RVQ streaming autoregressive What are Moshi's main components and what does each do?", "alt_query": "full-duplex spoken dialogue model components hierarchical autoregressive prediction multi-task stream latent representation What are Moshi's main components and what does each do?"}, "retrieval": {"query": "Moshi architecture Inner Monologue Time Extended Transformer TTT Residual Vector Quantization RVQ streaming autoregressive What are Moshi's main components and what does each do?", "papers": ["moshi"], "k": 3, "pids": ["moshi:2400:0009", "moshi:2400:0008", "moshi:2400:0003"]}}, "released_ms": 3241.6, "budget_wait_ms": 0.1, "tokens_in": 1982, "tokens_out": 429, "level_name": "full", "pipeline_model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 231, "completion_tokens": 82, "tokens_estimated": false, "ms": 359.33490000024904, "waited_s": 0.0}, {"step": "draft", "model": "openai/gpt-oss-120b", "status": 200, "outcome": "ok", "prompt_tokens": 1751, "completion_tokens": 347, "tokens_estimated": false, "ms": 2878.8045000037528, "waited_s": 0.0}]}}
{"type": "answer", "run_id": "burst-20261110T183141Z", "scenario": "burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q17", "request_id": "burst-20261110T183141Z-0011", "start_time": "2026-11-10T18:32:03.695+00:00", "arrival_offset_s": 22.442, "patience_s": 25.53, "gave_up": false, "waited_ms": 1762.0, "degraded": true, "reply": {"request_id": "burst-20261110T183141Z-0011", "question": "What is H-Net's p95 latency serving 1,000 simultaneous requests?", "kind": "answer", "level": 1, "text": "The encoder and decoder networks in H-Net face unique design constraints due to their dual objectives and computational requirements. [S1]", "sources": [{"sid": "S1", "cite": "2507.07955v2 p.5 §2.1.2", "pid": "dynamic_chunking:2400:0008", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p05-b011", "dynamic_chunking-p05-b012", "dynamic_chunking-p05-b013", "dynamic_chunking-p05-b014"]}, {"sid": "S2", "cite": "2410.00037v1 p.2 §1", "pid": "moshi:2400:0001", "paper": "moshi", "block_ids": ["moshi-p02-b002", "moshi-p02-b003"]}, {"sid": "S3", "cite": "2507.07955v2 p.22 §4", "pid": "dynamic_chunking:2400:0039", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p22-b007", "dynamic_chunking-p22-b008", "dynamic_chunking-p22-b009", "dynamic_chunking-p22-b010"]}], "notice": "answered by a fallback model because the preferred one was busy; checked for citations only (no second-model check)", "eta_s": null, "model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 233, "completion_tokens": 43}, {"step": "draft", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 1712, "completion_tokens": 39}], "spans": [{"name": "plan", "start_ms": 0.0, "end_ms": 0.9, "model": null, "outcome": "full (other model)", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 26.58