82000056445, "waited_s": 0.0}, {"step": "verify", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 1124, "completion_tokens": 6, "tokens_estimated": false, "ms": 159.24769999401178, "waited_s": 0.0}]}}
{"type": "answer", "run_id": "burst-20261110T183141Z", "scenario": "burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q3", "request_id": "burst-20261110T183141Z-0005", "start_time": "2026-11-10T18:32:02.401+00:00", "arrival_offset_s": 21.161, "patience_s": 39.15, "gave_up": false, "waited_ms": 1242.4, "degraded": true, "reply": {"request_id": "burst-20261110T183141Z-0005", "question": "How are the positional encodings built, and why sinusoids rather than learned embeddings?", "kind": "answer", "level": 1, "text": "The Transformer adds a positional encoding vector to each token embedding, where the encoding has the same dimension \\(d_{\\text{model}}\\) and is defined by sine and cosine functions of varying frequencies: for even indices \\(2i\\) it uses \\(\\sin(\\text{pos}/10000^{2i/d_{\\text{model}}})\\) and for odd indices \\(2i+1\\) it uses \\(\\cos(\\text{pos}/10000^{2i/d_{\\text{model}}})\\) so that each dimension corresponds to a sinusoid whose wavelength forms a geometric progression [S1].  \nThese sinusoidal encodings were chosen because a fixed offset \\(k\\) between positions can be expressed as a linear function of the original encodings, making it easy for the model to learn relative positions [S1].  \nThe authors also tried learned positional embeddings and found that performance was nearly the same as with sinusoids [S2].  \nHowever, they preferred the sinusoidal version because it can generalize to sequence lengths longer than those seen during training, whereas learned embeddings are limited to the lengths they were trained on [S1][S2].", "sources": [{"sid": "S1", "cite": "1706.03762v7 p.6 §3.5", "pid": "attention:2400:0011", "paper": "attention", "block_ids": ["attention-p06-b004", "attention-p06-b005", "attention-p06-b006", "attention-p06-b007", "attention-p06-b008", "attention-p06-b009"]}, {"sid": "S2", "cite": "1706.03762v7 pp.8-9 §6.2", "pid": "attention:2400:0020", "paper": "attention", "block_ids": ["attention-p08-b012", "attention-p08-b013", "attention-p09-b001", "attention-p09-b002", "attention-p09-b003", "attention-p09-b004", "attention-p09-b005"]}, {"sid": "S3", "cite": "1706.03762v7 pp.7-8 §5.4", "pid": "attention:2400:0018", "paper": "attention", "block_ids": ["attention-p07-b015", "attention-p08-b001", "attention-p08-b002", "attention-p08-b003", "attention-p08-b004"]}], "notice": "answered by a fallback model because the preferred one was busy; checked for citations only (no second-model check)", "eta_s": null, "model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 239, "completion_tokens": 56}, {"step": "draft", "model": "openai/gpt-oss-20b", "status": 200, "outcome": "ok", "prompt_tokens": 1321, "completion_tokens": 392}], "spans": [{"name": "plan", "start_ms": 0.0, "end_ms": 0.8, "model": null, "outcome": "full", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 0.0, "openai/gpt-oss-20b": 0.0, "qwen/qwen3.8-27b": 0.0}}, "drafter": "openai/gpt-oss-120b"}}, {"name": "understand", "start_ms": 0.8, "end_ms": 266.6, "model": null, "outcome": "router", "detail": {}}, {"name": "wait:understand", "start_ms": 0.8, "end_ms": 0.9, "model": "qwen/qwen3.8-27b", "outcome": "granted", "detail": {"waited_s": 0.0}}, {"name": "call:understand", "start_ms": 0.9, "end_ms": 266.6, "model": "qwen/qwen3.8-27b", "outcome": "200:ok", "detail": {}}, {"name": "retrieve", "start_ms": 266.6, "end_ms": 266.9, "model": null, "outcome": "1 search", "detail": {"query": "sinusoidal positional encoding formula absolute position relative ordering property How are the positional encodings built, and why sinusoids rather than learned embeddings?", "papers": ["attention"], "k": 3, "evidence": {"best": 0.719, "union": 0.719, "top_bm25": 56.081, "query_terms": 7}}}, {"name": "decide", "start_ms": 266.9, "end_ms": 266.9, "model": null, "outco