{"type": "answer", "run_id": "burst-20261110T183141Z", "scenario": "burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q2", "request_id": "burst-20261110T183141Z-0003", "start_time": "2026-11-10T18:32:02.201+00:00", "arrival_offset_s": 20.945, "patience_s": 44.03, "gave_up": false, "waited_ms": 1415.2, "degraded": false, "reply": {"request_id": "burst-20261110T183141Z-0003", "question": "Why use several attention heads instead of one, and what configuration did the paper use?", "kind": "answer", "level": 0, "text": "Instead of performing a single attention function with d_model-dimensional keys, values and queries, we found it beneficial to linearly project the queries, keys and values h times with different, learned linear projections to d_k, d_k and d_v dimensions, respectively. [S1]", "sources": [{"sid": "S1", "cite": "1706.03762v7 pp.4-5 §3.2.2", "pid": "attention:2400:0007", "paper": "attention", "block_ids": ["attention-p04-b015", "attention-p04-b016", "attention-p04-b017", "attention-p05-b001", "attention-p05-b002", "attention-p05-b003", "attention-p05-b004", "attention-p05-b005", "attention-p05-b006"]}, {"sid": "S2", "cite": "1706.03762v7 pp.3-4 §3.2", "pid": "attention:2400:0005", "paper": "attention", "block_ids": ["attention-p03-b007", "attention-p04-b001", "attention-p04-b002", "attention-p04-b003"]}, {"sid": "S3", "cite": "1706.03762v7 pp.8-9 §6.2", "pid": "attention:2400:0020", "paper": "attention", "block_ids": ["attention-p08-b012", "attention-p08-b013", "attention-p09-b001", "attention-p09-b002", "attention-p09-b003", "attention-p09-b004", "attention-p09-b005"]}], "notice": "", "eta_s": null, "model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 239, "completion_tokens": 33}, {"step": "draft", "model": "openai/gpt-oss-120b", "status": 200, "outcome": "ok", "prompt_tokens": 1165, "completion_tokens": 96}, {"step": "verify", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 1124, "completion_tokens": 6}], "spans": [{"name": "plan", "start_ms": 0.0, "end_ms": 0.6, "model": null, "outcome": "full", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 0.0, "openai/gpt-oss-20b": 0.0, "qwen/qwen3.8-27b": 0.0}}, "drafter": "openai/gpt-oss-120b"}}, {"name": "understand", "start_ms": 0.6, "end_ms": 254.2, "model": null, "outcome": "router", "detail": {}}, {"name": "wait:understand", "start_ms": 0.6, "end_ms": 0.7, "model": "qwen/qwen3.8-27b", "outcome": "granted", "detail": {"waited_s": 0.0}}, {"name": "call:understand", "start_ms": 0.7, "end_ms": 254.1, "model": "qwen/qwen3.8-27b", "outcome": "200:ok", "detail": {}}, {"name": "retrieve", "start_ms": 254.2, "end_ms": 255.0, "model": null, "outcome": "2 searches", "detail": {"query": "multi-head attention h=8 Why use several attention heads instead of one, and what configuration did the paper use?", "papers": ["attention"], "k": 3, "evidence": {"best": 0.501, "union": 0.653, "top_bm25": 22.59, "query_terms": 6}}}, {"name": "retrieve:again", "start_ms": 254.5, "end_ms": 255.0, "model": null, "outcome": "", "detail": {"query": "multiple heads 512 dimension head size Why use several attention heads instead of one, and what configuration did the paper use?", "evidence": {"best": 0.501, "union": 0.653, "top_bm25": 22.59, "query_terms": 6}}}, {"name": "decide", "start_ms": 255.1, "end_ms": 255.1, "model": null, "outcome": "draft", "detail": {"best": 0.501, "union": 0.653, "top_bm25": 22.59, "query_terms": 6}}, {"name": "draft", "start_ms": 255.1, "end_ms": 1254.6, "model": null, "outcome": "openai/gpt-oss-120b", "detail": {"level": "full"}}, {"name": "wait:draft", "start_ms": 255.2, "end_ms": 255.2, "model": "openai/gpt-oss-120b", "outcome": "granted", "detail": {"waited_s": 0.0}}, {"name": "call:draft", "start_ms": 255.2, "end_ms": 1254.6, "model": "openai/g