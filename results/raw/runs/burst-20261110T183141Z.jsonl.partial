tart_ms": 1362.8, "end_ms": 1362.8, "model": null, "outcome": "answer", "detail": {}}], "checks": {"gate": {"ok": true, "sentences": 1, "failures": []}, "verifier": null, "draft_model": "openai/gpt-oss-20b", "attempts": 1, "router": {"papers": ["moshi", "dynamic_chunking"], "query": "full-duplex turn-taking latency interruption Why do the authors say traditional spoken dialogue systems struggle to feel natural?", "alt_query": "half-duplex constraints pause detection naturalness Why do the authors say traditional spoken dialogue systems struggle to feel natural?"}, "retrieval": {"query": "full-duplex turn-taking latency interruption Why do the authors say traditional spoken dialogue systems struggle to feel natural?", "papers": ["moshi", "dynamic_chunking"], "k": 3, "pids": ["moshi:2400:0000", "moshi:2400:0001", "moshi:2400:0008"]}}, "released_ms": 1362.8, "budget_wait_ms": 0.1, "tokens_in": 1854, "tokens_out": 89, "level_name": "full (other model)", "pipeline_model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 238, "completion_tokens": 46, "tokens_estimated": false, "ms": 254.07309999718564, "waited_s": 0.0}, {"step": "draft", "model": "openai/gpt-oss-20b", "status": 200, "outcome": "ok", "prompt_tokens": 1616, "completion_tokens": 43, "tokens_estimated": false, "ms": 1105.5005000016536, "waited_s": 0.0}]}}
{"type": "answer", "run_id": "burst-20261110T183141Z", "scenario": "burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q7", "request_id": "burst-20261110T183141Z-0013", "start_time": "2026-11-10T18:32:04.055+00:00", "arrival_offset_s": 22.807, "patience_s": 17.85, "gave_up": false, "waited_ms": 5.2, "degraded": true, "reply": {"request_id": "burst-20261110T183141Z-0013", "question": "Why do the authors say traditional spoken dialogue systems struggle to feel natural?", "kind": "passages", "level": 3, "text": "No written answer this time: here are the most relevant passages from the papers, quoted as they are. A written answer should be possible in about 12 s.\n[S1] 2410.00037v1 p.2 §1: \"A solution to this challenge is handling the NLU and NLG with an LLM, while the ASR and TTS provide the voice interface during the user’s and the system’s turn respectively (Llama, 2024). This framework supports the current generation of spoken dialogue systems such as Gemini (Gemini et al., 2023) or ChatGPT.^4 Yet, the experience offered by these interfaces remains far from natural conversations. First, latency compounds along the many components of these pipelines, resulting in a typical global latency of several seconds.\"\n[S2] 2410.00037v1 p.1 Abstract: \"We introduce Moshi, a speech-text foundation model and full-duplex spoken dialogue framework. Current systems for spoken dialogue rely on pipelines of independent components, namely voice activity detection, speech recognition, textual dialogue and text-to-speech. Such frameworks cannot emulate the experience of real conversations. First, their complexity induces a latency of several seconds between interactions. Second, text being the intermediate modality for dialogue, non-linguistic information that modifies meaning— such as emotion or non-speech sounds— is lost in the interaction.\"", "sources": [{"sid": "S1", "cite": "2410.00037v1 p.2 §1", "pid": "moshi:2400:0001", "paper": "moshi", "block_ids": ["moshi-p02-b002", "moshi-p02-b003"]}, {"sid": "S2", "cite": "2410.00037v1 p.1 Abstract", "pid": "moshi:2400:0000", "paper": "moshi", "block_ids": ["moshi-p01-b005"]}], "notice": "passages only, no model call: no drafter free within 8 s", "eta_s": 12.4, "model_calls": [], "spans": [{"name": "plan", "start_ms": 0.0, "end_ms": 0.8, "model": null, "outcome": "passages", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 32.56520230000751, "openai/gpt-oss-20b": 13.493054800004757, "qwen/qwen3.8-27b": 55.9890000000014}, "lean": {"openai/gpt-oss-120b": 31.53770230000373, "openai/gpt-oss-20b": 12.443054800001846, "qwen/qwen3.8-27b": 55.9890000000014}}, "drafter": null}}, {"name": "retrieve", "start_ms": 0.8, "end_ms": 1.3, "model": null, "outcome": "1 search", "detail": {"query": "Why do the authors say traditional spoken dialogue systems struggle to feel natural?", "papers": null, "k": 2, "evidence": {"best": 0.426, "union": 0.426, "top_bm25": 14.626, "query_terms": 7}}}, {"name": "send", "start_ms": 3.7, "end_ms": 3.7, "model": null, "outcome": "passages", "detail": {}}], "checks": {}, "released_ms": 3.7, "budget_wait_ms": 0, "tokens_in": 0, "tokens_out": 0, "level_name": "passages", "pipeline_model_calls": []}}
{"type": "answer", "run_id": "burst-20261110T183141Z", "scenario": "burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q14", "request_id": "burst-20261110T183141Z-0009", "start_time": "2026-11-10T18:32:03.041+00:00", "arrival_offset_s": 21.79, "patience_s": 7.24, "gave_up": false, "waited_ms": 1019.6, "degraded": true, "reply": {"request_id": "burst-20261110T183141Z-0009", "question": "How does H-Net decide where to cut the byte stream into pieces?", "kind": "answer", "level": 1, "text": "Altogether, H-Net learns segmentation strategies optimized jointly with the main backbone, dynamically compressing input vectors based on contextual information into meaningful chunks. [S1]", "sources": [{"sid": "S1", "cite": "2507.07955v2 pp.2-4 §1", "pid": "dynamic_chunking:2400:0004", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p02-b011", "dynamic_chunking-p02-b012", "dynamic_chunking-p03-b001", "dynamic_chunking-p03-b002", "dynamic_chunking-p04-b001", "dynamic_chunking-p04-b002"]}, {"sid": "S2", "cite": "2507.07955v2 p.2 §1", "pid": "dynamic_chunking:2400:0002", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p02-b002", "dynamic_chunking-p02-b003", "dynamic_chunking-p02-b004", "dynamic_chunking-p02-b005", "dynamic_chunking-p02-b006", "dynamic_chunking-p02-b007"]}, {"sid": "S3", "cite": "2507.07955v2 pp.14-15 §3.1", "pid": "dynamic_chunking:2400:0028", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p14-b004", "dynamic_chunking-p14-b005", "dynamic_chunking-p14-b006", "dynamic_chunking-p14-b007", "dynamic_chunking-p14-b008", "dynamic_chunking-p15-b001", "dynamic_chunking-p15-b002", "dynamic_chunking-p15-b003"]}], "notice": "answered by a fallback model because the preferred one was busy; checked for citations only (no second-model check)", "eta_s": null, "model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b"