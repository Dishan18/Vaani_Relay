{"type": "answer", "run_id": "rpm_halved-20261110T183141Z", "scenario": "rpm_halved", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q12", "request_id": "rpm_halved-20261110T183141Z-0000", "start_time": "2026-11-10T18:32:03.535+00:00", "arrival_offset_s": 22.181, "patience_s": 36.19, "gave_up": false, "waited_ms": 1229.4, "degraded": false, "reply": {"request_id": "rpm_halved-20261110T183141Z-0000", "question": "What is Moshi's word error rate on noisy Indian English telephone calls?", "kind": "answer", "level": 0, "text": "Section 3.4.4 and Appendix C describe how Inner Monologue can provide a streaming TTS or streaming ASR system by simply changing the delay it uses between text and audio tokens. [S1]", "sources": [{"sid": "S1", "cite": "2410.00037v1 p.31 §5.7", "pid": "moshi:2400:0050", "paper": "moshi", "block_ids": ["moshi-p31-b003", "moshi-p31-b004", "moshi-p31-b005"]}, {"sid": "S2", "cite": "2410.00037v1 p.23 §5.2", "pid": "moshi:2400:0036", "paper": "moshi", "block_ids": ["moshi-p23-b004", "moshi-p23-b005", "moshi-p23-b006"]}, {"sid": "S3", "cite": "2410.00037v1 pp.17-18 §4.2", "pid": "moshi:2400:0027", "paper": "moshi", "block_ids": ["moshi-p17-b007", "moshi-p17-b008", "moshi-p17-b009", "moshi-p18-b001", "moshi-p18-b002", "moshi-p18-b003"]}], "notice": "", "eta_s": null, "model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 235, "completion_tokens": 47}, {"step": "draft", "model": "openai/gpt-oss-120b", "status": 200, "outcome": "ok", "prompt_tokens": 1736, "completion_tokens": 69}, {"step": "verify", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 1690, "completion_tokens": 6}], "spans": [{"name": "plan", "start_ms": 0.0, "end_ms": 0.7, "model": null, "outcome": "full", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 0.0, "openai/gpt-o