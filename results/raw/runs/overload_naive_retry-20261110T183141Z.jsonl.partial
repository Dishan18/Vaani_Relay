{"type": "answer", "run_id": "overload_naive_retry-20261110T183141Z", "scenario": "overload_naive_retry", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q2", "request_id": "overload_naive_retry-20261110T183141Z-0035", "start_time": "2026-11-10T18:33:54.995+00:00", "arrival_offset_s": 133.662, "patience_s": 10.07, "gave_up": false, "waited_ms": 5406.8, "degraded": true, "reply": {"request_id": "overload_naive_retry-20261110T183141Z-0035", "question": "Why use several attention heads instead of one, and what configuration did the paper use?", "kind": "answer", "level": 2, "text": "Instead of performing a single attention function with d_model-dimensional keys, values and queries, we found it beneficial to linearly project the queries, keys and values h times with different, learned linear projections to d_k, d_k and d_v dimensions, respectively. [S1]", "sources": [{"sid": "S1", "cite": "1706.03762v7 pp.4-5 §3.2.2", "pid": "attention:2400:0007", "paper": "attention", "block_ids": ["attention-p04-b015", "attention-p04-b016", "attention-p04-b017", "attention-p05-b001", "attention-p05-b002", "attention-p05-b003", "attention-p05-b004", "attention-p05-b005", "attention-p05-b006"]}, {"sid": "S2", "cite": "1706.03762v7 pp.3-4 §3.2", "pid": "attention:2400:0005", "paper": "attention", "block_ids": ["attention-p03-b007", "attention-p04-b001", "attention-p04-b002", "attention-p04-b003"]}], "notice": "shorter answer from fewer passages, without the extra checks, because the service is busy", "eta_s": null, "model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 239, "completion_tokens": 33}, {"step": "draft", "model": "openai/gpt-oss-120b", "status": 429, "outcome": "rate_limited", "prompt_tokens": 0, "completion_tokens": 0}, {"step": "draft", "model": "openai/gpt-oss-120b", "status": 429, "outcome": "rate