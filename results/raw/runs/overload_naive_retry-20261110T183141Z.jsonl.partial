granted", "detail": {"waited_s": 0.0}}, {"name": "call:draft", "start_ms": 3372.4, "end_ms": 6370.9, "model": "openai/gpt-oss-120b", "outcome": "429:rate_limited", "detail": {}}, {"name": "send", "start_ms": 6374.2, "end_ms": 6374.2, "model": null, "outcome": "passages", "detail": {}}], "checks": {"router": {"papers": ["dynamic_chunking"], "query": "H-Net parameters compute flops training energy co2 emissions environmental footprint How much energy (kWh) or CO2 did training the H-Net models use?", "alt_query": "computational cost gpu hours power consumption sustainability metrics How much energy (kWh) or CO2 did training the H-Net models use?"}, "retrieval": {"query": "H-Net parameters compute flops training energy co2 emissions environmental footprint How much energy (kWh) or CO2 did training the H-Net models use?", "papers": ["dynamic_chunking"], "k": 3, "pids": ["dynamic_chunking:2400:0024", "dynamic_chunking:2400:0008", "dynamic_chunking:2400:0040"]}}, "released_ms": 6374.2, "budget_wait_ms": 0.0, "tokens_in": 233, "tokens_out": 60, "level_name": "passages", "pipeline_model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 233, "completion_tokens": 60, "tokens_estimated": false, "ms": 351.668499999505, "waited_s": 0.0}, {"step": "draft", "model": "openai/gpt-oss-120b", "status": 429, "outcome": "rate_limited", "prompt_tokens": 0, "completion_tokens": 0, "tokens_estimated": true, "ms": 1.1052999980165623, "waited_s": 0.0}, {"step": "draft", "model": "openai/gpt-oss-120b", "status": 429, "outcome": "rate_limited", "prompt_tokens": 0, "completion_tokens": 0, "tokens_estimated": true, "ms": 1.1255999997956678, "waited_s": 0.0}]}}
{"type": "answer", "run_id": "overload_naive_retry-20261110T183141Z", "scenario": "overload_naive_retry", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q13", "request_id": "overload_naive_retry-20261110T183141Z-0022", "start_time": "2026-11-10T18:33:10.472+00:00", "arrival_offset_s": 89.132, "patience_s": 54.36, "gave_up": false, "waited_ms": 6310.7, "degraded": true, "reply": {"request_id": "overload_naive_retry-20261110T183141Z-0022", "question": "In H-Net, what do the encoder and decoder networks do, and at what resolution do they run?", "kind": "passages", "level": 3, "text": "No written answer this time: here are the most relevant passages from the papers, quoted as they are. A written answer should be possible in about 1 s.\n[S1] 2507.07955v2 pp.19-20 §3.3: \"A natural question arises: does the importance of Mamba layers (i) stem specifically from processing fine-grained byte inputs, or (ii) because they are better for compressing information into the next stage, even at coarser input resolutions? To investigate these hypotheses, we train a 1-stage H-Net on top of BPE-tokenized inputs processed by the GPT-2 tokenizer. We then evaluate six different encoder-decoder combinations.\"\n[S2] 2507.07955v2 p.2 §1: \"Hierarchical Processing. The H-Net adopts the hierarchical architecture from prior work (Goel et al. 2022; Nawrot, Tworkowski, et al. 2022; Slagle 2024), resembling an autoregressive U-Net (Ronneberger, Fischer, and Brox 2015): (i) raw data is processed by a small encoder network, (ii) then downsampled and passed through a main network operating on compressed chunks, (iii) and finally upsampled before being passed through a decoder network operating on the original resolution.\"", "sources": [{"sid": "S1", "cite": "2507.07955v2 pp.19-20 §3.3", "pid": "dynamic_chunking:2400:0035", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p