"detail": {"waited_s": 0.0}}, {"name": "call:draft", "start_ms": 268.1, "end_ms": 3934.2, "model": "openai/gpt-oss-120b", "outcome": "200:ok", "detail": {}}, {"name": "check", "start_ms": 3934.2, "end_ms": 4200.7, "model": null, "outcome": "pass", "detail": {"gate_ok": true, "failures": 0, "verifier": {"ok": true, "unsupported": [], "model": "qwen/qwen3.8-27b"}}}, {"name": "verify", "start_ms": 3934.8, "end_ms": 4200.7, "model": null, "outcome": "pass", "detail": {}}, {"name": "wait:verify", "start_ms": 3934.9, "end_ms": 3934.9, "model": "qwen/qwen3.8-27b", "outcome": "granted", "detail": {"waited_s": 0.0}}, {"name": "call:verify", "start_ms": 3934.9, "end_ms": 4200.7, "model": "qwen/qwen3.8-27b", "outcome": "200:ok", "detail": {}}, {"name": "send", "start_ms": 4200.8, "end_ms": 4200.8, "model": null, "outcome": "answer", "detail": {}}], "checks": {"gate": {"ok": true, "sentences": 1, "failures": []}, "verifier": {"ok": true, "unsupported": [], "model": "qwen/qwen3.8-27b"}, "draft_model": "openai/gpt-oss-120b", "attempts": 1, "router": {"papers": ["moshi"], "query": "ratio loss F G N variables loss function Why the ratio loss, and what are F, G and N?", "alt_query": "ratio-based objective F G N notation Why the ratio loss, and what are F, G and N?"}, "retrieval": {"query": "ratio loss F G N variables loss function Why the ratio loss, and what are F, G and N?", "papers": ["moshi"], "k": 3, "pids": ["moshi:2400:0035", "dynamic_chunking:2400:0015", "moshi:2400:0016"]}}, "released_ms": 4200.8, "budget_wait_ms": 0.0, "tokens_in": 3104, "tokens_out": 129, "level_name": "full", "pipeline_model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 229, "completion_tokens": 36, "tokens_estimated": false, "ms": 266.35450000321725, "waited_s": 0.0}, {"step": "draft", "model": "openai/gpt-oss-120b", "status": 200, "outcome": "ok", "prompt_tokens": 1453, "completion_tokens": 87, "tokens_estimated": false, "ms": 2667.6173000