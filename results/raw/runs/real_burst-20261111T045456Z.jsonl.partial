.9, "model": "openai/gpt-oss-20b", "outcome": "granted", "detail": {"waited_s": 0.0}}, {"name": "call:draft", "start_ms": 253.9, "end_ms": 713.6, "model": "openai/gpt-oss-20b", "outcome": "200:ok", "detail": {}}, {"name": "check", "start_ms": 713.6, "end_ms": 717.3, "model": null, "outcome": "pass", "detail": {"gate_ok": true, "failures": 0, "verifier": null}}, {"name": "verify", "start_ms": 717.1, "end_ms": 717.3, "model": null, "outcome": "skipped (no headroom)", "detail": {}}, {"name": "send", "start_ms": 717.4, "end_ms": 717.4, "model": null, "outcome": "answer", "detail": {}}], "checks": {"gate": {"ok": true, "sentences": 1, "failures": []}, "verifier": null, "draft_model": "openai/gpt-oss-20b", "attempts": 1, "retry": {"understand": {"sent_failures": 0, "retries": 0, "failed": []}, "draft": {"sent_failures": 0, "retries": 0, "failed": []}}, "router": {"papers": ["moshi"], "query": "ratio loss F G N variables loss function Why the ratio loss, and what are F, G and N?", "alt_query": "ratio-based objective F G N notation Why the ratio loss, and what are F, G and N?"}, "retrieval": {"query": "ratio loss F G N variables loss function Why the ratio loss, and what are F, G and N?", "papers": ["moshi"], "k": 3, "pids": ["moshi:2400:0035", "dynamic_chunking:2400:0015", "moshi:2400:0016"]}}, "released_ms": 717.4, "budget_wait_ms": 0.3, "tokens_in": 1692, "tokens_out": 128, "level_name": "full (other model)", "pipeline_model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 229, "completion_tokens": 36, "tokens_estimated": false, "ms": 246.6668999995818, "waited_s": 0.0}, {"step": "draft", "model": "openai/gpt-oss-20b", "status": 200, "outcome": "ok", "prompt_tokens": 1463, "completion_tokens": 92, "tokens_estimated": false, "ms": 459.28580000054353, "waited_s": 0.0}]}}
{"type": "answer", "run_id": "real_burst-20261111T045456Z", "scenario": "real_burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q15", "request_id": "real_burst-20261111T045456Z-0013", "start_time": "2026-11-11T04:55:06.269+00:00", "arrival_offset_s": 9.638, "patience_s": 9.2, "gave_up": false, "waited_ms": 8.4, "degraded": true, "reply": {"request_id": "real_burst-20261111T045456Z-0013", "question": "Why the ratio loss, and what are F, G and N?", "kind": "passages", "level": 3, "text": "No written answer this time: here are the most relevant passages from the papers, quoted as they are. A written answer should be possible in about 15 s.\n[S1] 2507.07955v2 p.8 §2.2.3: \"Inspired by load balancing mechanisms in Mixture-of-Experts (MoE) models (Fedus, Zoph, and Shazeer 2022), which face similar challenges in maintaining balanced expert utilization, we introduce a ratio loss to guide compression: L_ratio = N N− 1 ((N − 1)FG +(1−F)(1−G)), F = 1 L ∑︁^L t =1 b_t, G = 1 L ∑︁^L t =1 p_t, (10) whereF represents the fraction of vectors actually selected,G denotes the average boundary probability, andN controls the target compression ratio.\"\n[S2] 2507.07955v2 p.16 §3.2: \"Experimental setup for Chinese and code. On Chinese and code, we use 46B token subset from FineWeb-Edu-Chinese- V2.1 (Yu, Dai, et al. 2025) and Github subset from Pile (Gao, Biderman, et al. 2020) to train three models at the 1.3B GPT-3 XL scale: H-Net (2-stage), H-Net (space), and Transformer. We maintain the same bytes per gradient step (256 batch size with 8192 utf-8 encoded bytes per example) as the main text experiments. For the H-Net (2-stage), we use the same target downsampling ratio (N^0 =N^1 = 3) as the main experiments.\"", "sources": [{"sid": "S1", "cite": "2507.07955v2 p.8 §2.2.3", "pid": "dynamic_chunking:2400:0015", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p08-b006", "dynamic_chunking-p08-b007", "dynamic_chunking-p08-b008", "dynamic_chunking-p08-b009", "dynamic_chunking-p08-b010", "dynamic_chunking-p08-b011", "dynamic_chunking-p08-b012", "dynamic_chunking-p08-b013", "dynamic_chunking-p08-b014", "dynamic_chunking-p08-b015", "dynamic_chunking-p08-b016", "dynamic_chunking-p08-b017", "dynamic_chunking-p08-b018", "dynamic_chunking-p08-b019", "dynamic_chunking-p08-b020", "dynamic_chunking-p08-b021", "dynamic_chunking-p08-b022"]}, {"sid": "S2", "cite": "2507.07955v2 p.16 §3.2", "pid": "dynamic_chunking:2400:0030", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p16-b003", "dynamic_chunking-p16-b004"]}], "notice": "passages only, no model call: no drafter free within 15 s", "eta_s": 15.1, "model_calls": [], "spans": [{"name": "plan", "start_ms": 0.1, "end_ms": 2.6, "model": null, "outcome": "passages", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 22.873217999999724, "openai/gpt-oss-20b": 19.23544970000148, "qwen/qwen3.8-27b": 50.73700000000008}, "lean": {"openai/gpt-oss-120b": 18.84571800000049, "openai/gpt-oss-20b": 15.132949700000609, "qwen/qwen3.8-27b": 50.73700000000008}}, "drafter": null}}, {"name": "retrieve", "start_ms": 2.6, "end_ms": 3.6, "model": null, "outcome": "1 search", "detail": {"query": "Why the ratio loss, and what are F, G and N?", "papers": null, "k": 2, "evidence": {"best": 1.0, "union": 1.0, "top_bm25": 20.122, "query_terms": 5}}}, {"name": "send", "start_ms": 8.3, "end_ms": 8.3, "model": null, "outcome": "passages", "detail": {}}], "checks": {}, "released_ms": 8.3, "budget_wait_ms": 0, "tokens_in": 0, "tokens_out": 0, "level_name": "passages", "pipeline_model_calls": []}}
{"type": "answer", "run_id": "real_burst-20261111T045456Z", "scenario": "real_burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q8", "request_id": "real_burst-20261111T045456Z-0015", "start_time": "2026-11-11T04:55:07.120+00:00", "arrival_offset_s": 10.464, "patience_s": 30.7, "gave_up": false, "waited_ms": 10.2, "degraded": true, "reply": {"request_id": "real_burst-20261111T045456Z-0015", "question": "What are Moshi's main components and what does each do?", "kind": "passages", "level": 3, "text": "No written answer this time: here are the most relevant passages from the papers, quoted as they are. A written answer should be possible in about 18 s.\n[S1] 2410.00037v1 pp.6-7 §3.1: \"To jointly model the audio streams from Moshi and the user, as well as Moshi’s text tokens, we rely on a Depth Transformer compatible with streaming inference (Sections 3.4.1, 3.4.2). In this section, we further detail each of these components. We then describe the training datasets and the different training phases we used to train Moshi in Section 4. Finally, in Section 5, we report thorough evaluation results on Moshi’s abilities, both linguistic and acoustic, as well as ablation experiments on its main components, while Section 6 provides analyses on the safety of our system.\"\n[S2] 2507.07955v2 pp.4-5 §2.1.1: \"H-Net employs a hierarchical architecture comprising three primary components – encoder networks (E), main network (M), and decoder networks (D) – where each component is implemented with a stack of sequence mixing layers (e.g., Transformers or state space models). In its simplest form, a single-stage H-Net consists of one encoder network, one main network, and one decoder network. Crucially, the architecture’s key characteristic lies in the main network’s unique property: it can itself be instantiated as a complete H-Net, enabling recursive construction of multi-level hierarchies.\"", "sources": [{"sid": "S1", "cite": "2410.00037v1 pp.6-7 §3.1", "pid": "moshi:2400:0009", "paper": "moshi", "block_ids": ["moshi-p06-b005", "moshi-p07-b001", "moshi-p07-b002"]}, {"sid": "S2", "cite": "2507.07955v2 pp.4-5 §2.1.1", "pid": "dynamic_chunking:2400:0007", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p04-b013", "dynamic_chunking-p04-b014", "dynamic_chunking-p04-b015", "dynamic_chunking-p05-b001", "dynamic_chunking-p05-b002", "dynamic_chunking-p05-b003", "dynamic_chunking-p05-b004", "dynamic_chunking-p05-b005", "dynamic_chunking-p05-b006", "dynamic_chunking-p05-b007", "dynamic_chunking-p05-b008", "dynamic_chunking-p05-b009"]}], "notice": "passages only, no model call: no drafter free within 15 s", "eta_s": 18.5, "model_calls": [], "spans": [{"name": "plan", "start_ms": 0.1, "end_ms": 1.2, "model": null, "outcome": "passages", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 22.14071799999965, "openai/gpt-oss-20b": 25.515449700000318, "qwen/qwen3.8-27b": 49.8769999999995}, "lean": {"openai/gpt-oss-120b": 18.47321799999918, "openai/gpt-oss-20b": 21.795449700000063, "qwen/qwen3.8-27b": 49.8769999999995}}, "drafter": null}}, {"name": "retrieve", "start_ms": 1.2, "end_ms": 1.8, "model": null, "outcome": "1 search", "detail": {"query": "What are Moshi's main components and what does each do?", "papers": null, "k": 2, "evidence": {"best": 1.0, "union": 1.0, "top_bm25": 8.984, "query_terms": 5}}}, {"name": "send", "start_ms": 10.2, "end_ms": 10.2, "model": null, "outcome": "passages", "detail": {}}], "checks": {}, "released_ms": 10.2, "budget_wait_ms": 0, "tokens_in": 0, "tokens_out": 0, "level_name": "passages", "pipeline_model_calls": []}}
{"type": "answer", "run_id": "real_burst-20261111T045456Z", "scenario": "real_burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q7", "request_id": "real_burst-20261111T045456Z-0016", "start_time": "2026-11-11T04:55:07.427+00:00", "arrival_offset_s": 10.802, "patience_s": 30.89, "gave_up": false, "waited_ms": 10.3, "degraded": true, "reply": {"request_id": "real_burst-20261111T045456Z-0016", "question": "Why do the authors say traditional spoken dialogue systems struggle to feel natural?", "kind": "passages", "level": 3, "text": "No written answer this time: here are the most relevant passages from the papers, quoted as they are. A written answer should be possible in about 18 s.\n[S1] 2410.00037v1 p.2 §1: \"A solution to this challenge is handling the NLU and NLG with an LLM, while the ASR and TTS provide the voice interface during the user’s and the system’s turn respectively (Llama, 2024). This framework supports the current generation of spoken dialogue systems such as Gemini (Gemini et al., 2023) or ChatGPT.^4 Yet, the experience offered by these interfaces remains far from natural conversations. First, latency compounds along the many components of these pipelines, resulting in a typical global latency of several seconds.\"\n[S2] 2410.00037v1 p.1 Abstract: \"We introduce Moshi, a speech-text foundation model and full-duplex spoken dialogue framework. Current systems for spoken dialogue rely on pipelines of independent components, namely voice activity detection, speech recognition, textual dialogue and text-to-speech. Such frameworks cannot emulate the experience of real conversations. First, their complexity induces a latency of several seconds between interactions. Second, text being the intermediate modality for dialogue, non-linguistic information that modifies meaning— such as emotion or non-speech sounds— is lost in the interaction.\"", "sources": [{"sid": "S1", "cite": "2410.00037v1 p.2 §1", "pid": "moshi:2400:0001", "paper": "moshi", "block_ids": ["moshi-p02-b002", "moshi-p02-b003"]}, {"sid": "S2", "cite": "2410.00037v1 p.1 Abstract", "pid": "moshi:2400:0000", "paper": "moshi", "block_ids": ["moshi-p01-b005"]}], "notice": "passages only, no model call: no drafter free within 15 s", "eta_s": 17.9, "model_calls": [], "spans": [{"name": "plan", "start_ms": 0.1, "end_ms": 1.1, "model": null, "outcome": "passages", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 18.888718000000154, "openai/gpt-oss-20b": 22.218449700000747, "qwen/qwen3.8-27b": 49.57999999999993}, "lean": {"openai/gpt-oss-120b": 17.861218000000008, "openai/gpt-oss-20b": 21.175949700001183, "qwen/qwen3.8-27b": 49.57999999999993}}, "drafter": null}}, {"name": "retrieve", "start_ms": 1.1, "end_ms": 1.6, "model": null, "outcome": "1 search", "detail": {"query": "Why do the authors say traditional spoken dialogue systems struggle to feel natural?", "papers": null, "k": 2, "evidence": {"best": 0.426, "union": 0.426, "top_bm25": 14.626, "query_terms": 7}}}, {"name": "send", "start_ms": 10.3, "end_ms": 10.3, "model": null, "outcome": "passages", "detail": {}}], "checks": {}, "released_ms": 10.3, "budget_wait_ms": 0, "tokens_in": 0, "tokens_out": 0, "level_name": "passages", "pipeline_model_calls": []}}
{"type": "answer", "run_id": "real_burst-20261111T045456Z", "scenario": "real_burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q9", "request_id": "real_burst-20261111T045456Z-0017", "start_time": "2026-11-11T04:55:07.656+00:00", "arrival_offset_s": 11.023, "patience_s": 25.69, "gave_up": false, "waited_ms": 19.0, "degraded": true, "reply": {"request_id": "real_burst-20261111T045456Z-0017", "question": "What makes Moshi full-duplex, and how does it handle both sides speaking at once?", "kind": "passages", "level": 3, "text": "No written answer this time: here are the most relevant passages from the papers, quoted as they are. A written answer should be possible in about 16 s.\n[S1] 2410.00037v1 p.5 §2: \"Spoken Dialogue Models. Spoken dialogue is one of the less explored tasks in speech generation, as it requires addressing several challenges: 1) The model should run in real time and allow for long conversations in full-duplex—the model always listens and can speak at any moment; 2) it should be speech-to-speech to handle paralinguistic communication; 3) it should display knowledge and reasoning abilities that make it amenable to helpful and enjoyable conversations.\"\n[S2] 2410.00037v1 pp.6-7 §3.1: \"Moshi is a multi-stream speech-to-speech Transformer model, which allows for full-duplex spoken dialogue with a user thanks to an innovative architecture summarized in Figure 1. Moshi is built on top of Helium, a text LLM which we build from scratch (Section 3.2), relying on high-quality text data to provide strong reasoning abilities to the model. We also propose Inner Monologue (Section 3.4.4), a training and inference procedure in which we jointly model text and audio tokens.\"", "sources": [{"sid": "S1", "cite": "2410.00037v1 p.5 §2", "pid": "moshi:2400:0007", "paper": "moshi", "block_ids": ["moshi-p05-b001", "moshi-p05-b002"]}, {"sid": "S2", "cite": "2410.00037v1 pp.6-7 §3.1", "pid": "moshi:2400:0009", "paper": "moshi", "block_ids": ["moshi-p06-b005", "moshi-p07-b001", "moshi-p07-b002"]}], "notice": "passages only, no model call: no drafter free within 15 s", "eta_s": 16.4, "model_calls": [], "spans": [{"name": "plan", "start_ms": 0.2, "end_ms": 4.3, "model": null, "outcome": "passages", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 20.11721799999941, "openai/gpt-oss-20b": 23.46944970000095, "qwen/qwen3.8-27b": 49.34599999999955}, "lean": {"openai/gpt-oss-120b": 16.449717999999848, "openai/gpt-oss-20b": 19.749449700000696, "qwen/qwen3.8-27b": 49.34599999999955}}, "drafter": null}}, {"name": "retrieve", "start_ms": 4.3, "end_ms": 6.5, "model": null, "outcome": "1 search", "detail": {"query": "What makes Moshi full-duplex, and how does it handle both sides speaking at once?", "papers": null, "k": 2, "evidence": {"best": 0.936, "union": 1.0, "top_bm25": 22.943, "query_terms": 8}}}, {"name": "send", "start_ms": 18.9, "end_ms": 19.0, "model": null, "outcome": "passages", "detail": {}}], "checks": {}, "released_ms": 19.0, "budget_wait_ms": 0, "tokens_in": 0, "tokens_out": 0, "level_name": "passages", "pipeline_model_calls": []}}
{"type": "answer", "run_id": "real_burst-20261111T045456Z", "scenario": "real_burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q9", "request_id": "real_burst-20261111T045456Z-0019", "start_time": "2026-11-11T04:55:08.230+00:00", "arrival_offset_s": 11.591, "patience_s": 32.4, "gave_up": false, "waited_ms": 4.8, "degraded": true, "reply": {"request_id": "real_burst-20261111T045456Z-0019", "question": "What makes Moshi full-duplex, and how does it handle both sides speaking at once?", "kind": "passages", "level": 3, "text": "No written answer this time: here are the most relevant passages from the papers, quoted as they are. A written answer should be possible in about 19 s.\n[S1] 2410.00037v1 p.5 §2: \"Spoken Dialogue Models. Spoken dialogue is one of the less explored tasks in speech generation, as it requires addressing several challenges: 1) The model should run in real time and allow for long conversations in full-duplex—the model always listens and can speak at any moment; 2) it should be speech-to-speech to handle paralinguistic communication; 3) it should display knowledge and reasoning abilities that make it amenable to helpful and enjoyable conversations.\"\n[S2] 2410.00037v1 pp.6-7 §3.1: \"Moshi is a multi-stream speech-to-speech Transformer model, which allows for full-duplex spoken dialogue with a user thanks to an innovative architecture summarized in Figure 1. Moshi is built on top of Helium, a text LLM which we build from scratch (Section 3.2), relying on high-quality text data to provide strong reasoning abilities to the model. We also propose Inner Monologue (Section 3.4.4), a training and inference procedure in which we jointly model text and audio tokens.\"", "sources": [{"sid": "S1", "cite": "2410.00037v1 p.5 §2", "pid": "moshi:2400:0007", "paper": "moshi", "block_ids": ["moshi-p05-b001", "moshi-p05-b002"]}, {"sid": "S2", "cite