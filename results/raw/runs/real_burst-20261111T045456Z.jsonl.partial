{"type": "answer", "run_id": "real_burst-20261111T045456Z", "scenario": "real_burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q9", "request_id": "real_burst-20261111T045456Z-0011", "start_time": "2026-11-11T04:55:04.352+00:00", "arrival_offset_s": 7.736, "patience_s": 12.29, "gave_up": false, "waited_ms": 4959.5, "degraded": false, "reply": {"request_id": "real_burst-20261111T045456Z-0011", "question": "What makes Moshi full-duplex, and how does it handle both sides speaking at once?", "kind": "answer", "level": 0, "text": "Moreover, Inner Monologue decomposes speech on a per-frame basis, which means that each prediction step outputs a speech frame. [S1]", "sources": [{"sid": "S1", "cite": "2410.00037v1 p.5 §2", "pid": "moshi:2400:0007", "paper": "moshi", "block_ids": ["moshi-p05-b001", "moshi-p05-b002"]}, {"sid": "S2", "cite": "2410.00037v1 pp.6-7 §3.1", "pid": "moshi:2400:0009", "paper": "moshi", "block_ids": ["moshi-p06-b005", "moshi-p07-b001", "moshi-p07-b002"]}, {"sid": "S3", "cite": "2410.00037v1 p.6 §2", "pid": "moshi:2400:0008", "paper": "moshi", "block_ids": ["moshi-p06-b001", "moshi-p06-b002"]}], "notice": "the question was searched as written (query rewriting was skipped); checked for citations only (no second-model check)", "eta_s": null, "model_calls": [{"step": "draft", "model": "openai/gpt-oss-120b", "status": 200, "outcome": "ok", "prompt_tokens": 1454, "completion_tokens": 51}], "spans": [{"name": "plan", "start_ms": 7.5, "end_ms": 8.1, "model": null, "outcome": "full", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 1.5142180000002554, "openai/gpt-oss-20b": 10.321482000000287, "qwen/qwen3.8-27b": 66.7430000000004}}, "drafter": "openai/gpt-oss-120b"}}, {"name": "understand", "start_ms": 8.1, "end_ms": 8.3, "model": null, "outcome": "heuristic (qwen/qwen3.8-27b: OTPM would not have room before the deadline (0 queu