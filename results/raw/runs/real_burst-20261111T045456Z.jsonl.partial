{"type": "answer", "run_id": "real_burst-20261111T045456Z", "scenario": "real_burst", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q15", "request_id": "real_burst-20261111T045456Z-0008", "start_time": "2026-11-11T04:55:04.041+00:00", "arrival_offset_s": 7.409, "patience_s": 51.37, "gave_up": false, "waited_ms": 717.8, "degraded": true, "reply": {"request_id": "real_burst-20261111T045456Z-0008", "question": "Why the ratio loss, and what are F, G and N?", "kind": "answer", "level": 1, "text": "Objective and subjective (MUSHRA) evaluation of audio quality for baseline neural audio codecs—R VQGAN (Kumar et al., 2024), Seman-tiCodec (Liu et al., 2024), and SpeechTokenizer (Zhang et al., 2024b)— and the most important variants of Mimi. [S1]", "sources": [{"sid": "S1", "cite": "2410.00037v1 p.23 §5.1", "pid": "moshi:2400:0035", "paper": "moshi", "block_ids": ["moshi-p23-b001", "moshi-p23-b002"]}, {"sid": "S2", "cite": "2507.07955v2 p.8 §2.2.3", "pid": "dynamic_chunking:2400:0015", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p08-b006", "dynamic_chunking-p08-b007", "dynamic_chunking-p08-b008", "dynamic_chunking-p08-b009", "dynamic_chunking-p08-b010", "dynamic_chunking-p08-b011", "dynamic_chunking-p08-b012", "dynamic_chunking-p08-b013", "dynamic_chunking-p08-b014", "dynamic_chunking-p08-b015", "dynamic_chunking-p08-b016", "dynamic_chunking-p08-b017", "dynamic_chunking-p08-b018", "dynamic_chunking-p08-b019", "dynamic_chunking-p08-b020", "dynamic_chunking-p08-b021", "dynamic_chunking-p08-b022"]}, {"sid": "S3", "cite": "2410.00037v1 p.11 §3.3.1", "pid": "moshi:2400:0016", "paper": "moshi", "block_ids": ["moshi-p11-b002", "moshi-p11-b003"]}], "notice": "answered by a fallback model because the preferred one was busy; checked for citations only (no second-model check)", "eta_s": null, "model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27