{"type": "answer", "run_id": "overload-20261110T183141Z", "scenario": "overload", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q10", "request_id": "overload-20261110T183141Z-0006", "start_time": "2026-11-10T18:32:03.908+00:00", "arrival_offset_s": 22.626, "patience_s": 15.68, "gave_up": false, "waited_ms": 668.3, "degraded": true, "reply": {"request_id": "overload-20261110T183141Z-0006", "question": "What is Inner Monologue, and how does it give streaming ASR and TTS?", "kind": "answer", "level": 1, "text": "Section 3.4.4 and Appendix C describe how Inner Monologue can provide a streaming TTS or streaming ASR system by simply changing the delay it uses between text and audio tokens. [S1]", "sources": [{"sid": "S1", "cite": "2410.00037v1 p.31 §5.7", "pid": "moshi:2400:0050", "paper": "moshi", "block_ids": ["moshi-p31-b003", "moshi-p31-b004", "moshi-p31-b005"]}, {"sid": "S2", "cite": "2410.00037v1 pp.41-42 §7", "pid": "moshi:2400:0065", "paper": "moshi", "block_ids": ["moshi-p41-b005", "moshi-p41-b006", "moshi-p41-b007", "moshi-p41-b008", "moshi-p42-b001"]}, {"sid": "S3", "cite": "2410.00037v1 p.5 §2", "pid": "moshi:2400:0007", "paper": "moshi", "block_ids": ["moshi-p05-b001", "moshi-p05-b002"]}], "notice": "answered by a fallback model because the preferred one was busy; checked for citations only (no second-model check)", "eta_s": null, "model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 234, "completion_tokens": 54}, {"step": "draft", "model": "openai/gpt-oss-20b", "status": 200, "outcome": "ok", "prompt_tokens": 1682, "completion_tokens": 82}], "spans": [{"name": "plan", "start_ms": 0.0, "end_ms": 0.7, "model": null, "outcome": "full (other model)", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 2.1435442000001785, "openai/gpt-oss-20b": 0.0, "qwen/qwen3.8-27b": 0.0}},