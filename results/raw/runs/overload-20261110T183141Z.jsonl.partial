{"type": "answer", "run_id": "overload-20261110T183141Z", "scenario": "overload", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q12", "request_id": "overload-20261110T183141Z-0033", "start_time": "2026-11-10T18:33:52.260+00:00", "arrival_offset_s": 130.963, "patience_s": 14.12, "gave_up": false, "waited_ms": 610.6, "degraded": true, "reply": {"request_id": "overload-20261110T183141Z-0033", "question": "What is Moshi's word error rate on noisy Indian English telephone calls?", "kind": "answer", "level": 2, "text": "We use a first audio collection of 7 million hours, which we call the unsupervised audio dataset, of readily available audio content, the majority of which contains English speech. [S1]", "sources": [{"sid": "S1", "cite": "2410.00037v1 pp.17-18 §4.2", "pid": "moshi:2400:0027", "paper": "moshi", "block_ids": ["moshi-p17-b007", "moshi-p17-b008", "moshi-p17-b009", "moshi-p18-b001", "moshi-p18-b002", "moshi-p18-b003"]}, {"sid": "S2", "cite": "2410.00037v1 pp.16-17 §3.4.4", "pid": "moshi:2400:0024", "paper": "moshi", "block_ids": ["moshi-p16-b006", "moshi-p16-b007", "moshi-p16-b008", "moshi-p16-b009", "moshi-p16-b010", "moshi-p17-b001"]}], "notice": "shorter answer from fewer passages, without the extra checks, because the service is busy", "eta_s": null, "model_calls": [{"step": "draft", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 1184, "completion_tokens": 52}], "spans": [{"name": "plan", "start_ms": 0.0, "end_ms": 1.5, "model": null, "outcome": "lean", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 8.250030500006687, "openai/gpt-oss-20b": 12.855890399994678, "qwen/qwen3.8-27b": 5.59222129999398}, "lean": {"openai/gpt-oss-120b": 4.072530500008725, "openai/gpt-oss-20b": 8.610890399999334, "qwen/qwen3.8-27b": 1.2122212999965996}}, "drafter": "qwen/qwen3.8-27b"}}, {"name": "understand", "start_ms"