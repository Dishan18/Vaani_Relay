{"type": "answer", "run_id": "overload-20261110T183141Z", "scenario": "overload", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q1", "request_id": "overload-20261110T183141Z-0030", "start_time": "2026-11-10T18:33:46.981+00:00", "arrival_offset_s": 125.69, "patience_s": 22.5, "gave_up": false, "waited_ms": 1311.5, "degraded": true, "reply": {"request_id": "overload-20261110T183141Z-0030", "question": "In simple terms, what does scaled dot-product attention compute, and why divide the query-key dot products by sqrt(d_k)?", "kind": "answer", "level": 1, "text": "In simple terms, scaled dot-product attention computes a weighted sum of input values, where the weight for each value is determined by the compatibility between a query and its corresponding key [S2]. This compatibility is measured by calculating the dot product of the query vector with all key vectors [S1]. The raw dot products are then divided by the square root of the query and key dimension, denoted as $d_k$, and a softmax function is applied to these scaled scores to generate the final attention weights [S1]. Dividing by $\\sqrt{d_k}$ is necessary to prevent the dot products from becoming too large in magnitude when the dimensionality is high [S1]. If the dot products grow too large, it pushes the softmax function into regions where it has extremely small gradients, which hinders effective learning [S1]. This scaling ensures that the attention mechanism remains stable and efficient during training for larger values of $d_k$ [S1].", "sources": [{"sid": "S1", "cite": "1706.03762v7 p.4 §3.2.1", "pid": "attention:2400:0006", "paper": "attention", "block_ids": ["attention-p04-b005", "attention-p04-b006", "attention-p04-b007", "attention-p04-b008", "attention-p04-b009", "attention-p04-b010", "attention-p04-b011", "attention-p04-b012", "attention-p04-b013"]}, {"sid": "S2", "cite": "1706.03762v7 pp.3-4 §3.2", "pid": "attention:2400:0005", "paper": "attention", "block_ids": ["attention-p03-b007", "attention-p04-b001", "attention-p04-b002", "attention-p04-b003"]}, {"sid": "S3", "cite": "1706.03762v7 pp.4-5 §3.2.2", "pid": "attention:2400:0007", "paper": "attention", "block_ids": ["attention-p04-b015", "attention-p04-b016", "attention-p04-b017", "attention-p05-b001", "attention-p05-b002", "attention-p05-b003", "attention-p05-b004", "attention-p05-b005", "attention-p05-b006"]}], "notice": "answered by a fallback model because the preferred one was busy; checked for citations only (no second-model check)", "eta_s": null, "model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 246, "completion_tokens": 69}, {"step": "draft", "model": "openai/gpt-oss-20b", "status": 200, "outcome": "ok", "prompt_tokens": 1044, "completion_tokens": 340}], "spans": [{"name": "plan", "start_ms": 0.0, "end_ms": 1.2, "model": null, "outcome": "full (other model)", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 10.808567799991579, "openai/gpt-oss-20b": 0.0, "qwen/qwen3.8-27b": 0.0}}, "drafter": "openai/gpt-oss-20b"}}, {"name": "understand", "start_ms": 1.2, "end_ms": 321.0, "model": null, "outcome": "router", "detail": {}}, {"name": "wait:understand", "start_ms": 1.2, "end_ms": 1.4, "model": "qwen/qwen3.8-27b", "outcome": "granted", "detail": {"waited_s": 0.0}}, {"name": "call:understand", "start_ms": 1.4, "end_ms": 321.0, "model": "qwen/qwen3.8-27b", "outcome": "200:ok", "detail": {}}, {"name": "retrieve", "start_ms": 321.1, "end_ms": 321.4, "model": null, "outcome": "1 search", "detail": {"query": "scaled dot-product attention temperature d_k softmax probability distribution vanishing gradients In simple terms, what does scaled dot-product attention compute, and why divide the query-key dot products by sqrt(d_k)?", "papers": ["attention"], "k": 3, "evidence": {"best": 0.832, "union": 0.832, "top_bm25": 87.907, "query_terms": 13}}}, {"name": "decide", "start_ms": 321.4, "end_ms": 321.4, "model": null, "outcome": "draft", "detail": {"best": 0.832, "union": 0.832, "top_bm25": 87.907, "query_terms": 13}}, {"name": "draft", "start_ms": 321.5, "end_ms": 1310.2, "model": null, "outcome": "openai/gpt-oss-20b", "detail": {"level": "full (other model)"}}, {"name": "wait:draft", "start_ms": 321.5, "end_ms": 321.5, "model": "openai/gpt-oss-20b", "outcome": "granted", "detail": {"waited_s": 0.0}}, {"name": "call:draft", "start_ms": 321.5, "end_ms": 1310.2, "model": "openai/gpt-oss-20b", "outcome": "200:ok", "detail": {}}, {"name": "check", "start_ms": 1310.3, "end_ms": 1311.2, "model": null, "outcome": "pass", "detail": {"gate_ok": true, "failures": 0, "verifier": null}}, {"name": "verify", "start_ms": 1310.8, "end_ms": 1311.2, "model": null, "outcome": "skipped (no headroom)", "detail": {}}, {"name": "send", "start_ms": 1311.2, "end_ms": 1311.2, "model": null, "outcome": "answer", "detail": {}}], "checks": {"gate": {"ok": true, "sentences": 6, "failures": []}, "verifier": null, "draft_model": "openai/gpt-oss-20b", "attempts": 1, "router": {"papers": ["attention"], "query": "scaled dot-product attention temperature d_k softmax probability distribution vanishing gradients In simple terms, what does scaled dot-product attention compute, and why divide the query-key dot products by sqrt(d_k)?", "alt_query": "rescaling attention scores prevent saturation deep in backpropagation high magnitude dot products In simple terms, what does scaled dot-product attention compute, and why divide the query-key dot products by sqrt(d_k)?"}, "retrieval": {"query": "scaled dot-product attention temperature d_k softmax probability distribution vanishing gradients In simple terms, what does scaled dot-product attention compute, and why divide the query-key dot products by sqrt(d_k)?", "papers": ["attention"], "k": 3, "pids": ["attention:2400:0006", "attention:2400:0005", "attention:2400:0007"]}}, "release