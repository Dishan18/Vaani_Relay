{"type": "answer", "run_id": "overload-20261110T183141Z", "scenario": "overload", "source": "stand-in", "setting": "large", "setting_def": {"piece_chars": 2400, "k": 3, "rerank": false, "router": true}, "drafter": "openai/gpt-oss-120b", "qid": "Q11", "request_id": "overload-20261110T183141Z-0025", "start_time": "2026-11-10T18:33:33.033+00:00", "arrival_offset_s": 111.745, "patience_s": 30.83, "gave_up": false, "waited_ms": 668.6, "degraded": true, "reply": {"request_id": "overload-20261110T183141Z-0025", "question": "What theoretical and practical latency does the paper report?", "kind": "answer", "level": 1, "text": "The paper reports a theoretical latency of 160 ms, and a practical latency of 200 ms in its real‑time full‑duplex dialogue system. [S2]", "sources": [{"sid": "S1", "cite": "2410.00037v1 pp.25-26 §5.3", "pid": "moshi:2400:0040", "paper": "moshi", "block_ids": ["moshi-p25-b006", "moshi-p25-b007", "moshi-p26-b001", "moshi-p26-b002"]}, {"sid": "S2", "cite": "2410.00037v1 p.1 Abstract", "pid": "moshi:2400:0000", "paper": "moshi", "block_ids": ["moshi-p01-b005"]}, {"sid": "S3", "cite": "2410.00037v1 p.26 §5.3", "pid": "moshi:2400:0041", "paper": "moshi", "block_ids": ["moshi-p26-b003", "moshi-p26-b004"]}], "notice": "answered by a fallback model because the preferred one was busy; checked for citations only (no second-model check)", "eta_s": null, "model_calls": [{"step": "understand", "model": "qwen/qwen3.8-27b", "status": 200, "outcome": "ok", "prompt_tokens": 233, "completion_tokens": 51}, {"step": "draft", "model": "openai/gpt-oss-20b", "status": 200, "outcome": "ok", "prompt_tokens": 1594, "completion_tokens": 62}], "spans": [{"name": "plan", "start_ms": 0.0, "end_ms": 0.6, "model": null, "outcome": "full (other model)", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 3.140908599998511, "openai/gpt-oss-20b": 0.0, "qwen/qwen3.8-27b": 0.0}}, "drafter": "openai/gpt-oss-20b"}}, {"name": "understand", "start_ms": 0.6, "end_ms": 247.2, "model"