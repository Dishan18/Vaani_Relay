{"type": "answer", "run_id": "retrieval-part2-lean-rest-20261111", "scenario": "eval:retrieval", "source": "real", "setting": "small_lean", "setting_def": {"piece_chars": 600, "k": 4, "rerank": false, "router": false}, "drafter": "openai/gpt-oss-120b", "qid": "Q14", "request_id": "retrieval-part2-lean-rest-20261111-small_lean-gpt-oss-120b-Q14", "start_time": "2026-11-11T04:38:50.830+00:00", "degraded": false, "reply": {"request_id": "retrieval-part2-lean-rest-20261111-small_lean-gpt-oss-120b-Q14", "question": "How does H-Net decide where to cut the byte stream into pieces?", "kind": "answer", "level": 0, "text": "H‑Net determines chunk boundaries on‑the‑fly by letting each byte (treated as a token) decide, during inference, how much computation it should receive; tokens that the model judges to require more processing trigger the larger verification network to operate on a contiguous segment of bytes, while others are handled only by the small draft network[S2].  This dynamic, per‑token compute allocation effectively “cuts” the byte stream into chunks wherever the model predicts a higher compute need, producing the boundaries visualized in Figure 4 for both the one‑stage and two‑stage variants[S1].", "sources": [{"sid": "S1", "cite": "2507.07955v2 p.14 §3.1", "pid": "dynamic_chunking:600:0103", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p14-b004"]}, {"sid": "S2", "cite": "2507.07955v2 p.10 §2.4", "pid": "dynamic_chunking:600:0075", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p10-b010"]}, {"sid": "S3", "cite": "2507.07955v2 p.12 §3.1", "pid": "dynamic_chunking:600:0093", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p12-b012"]}, {"sid": "S4", "cite": "2507.07955v2 p.16 §3.2", "pid": "dynamic_chunking:600:0111", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p16-b001", "dynamic_chunking-p16-b002"]}], "notice": "checked for citations only (no second-model check)", "eta_s": null, "model_calls": [{"step": "d