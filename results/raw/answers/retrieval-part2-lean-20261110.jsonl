{"type": "answer", "run_id": "retrieval-part2-lean-20261110", "scenario": "eval:retrieval", "source": "real", "setting": "small_lean", "setting_def": {"piece_chars": 600, "k": 4, "rerank": false, "router": false}, "drafter": "openai/gpt-oss-120b", "qid": "Q2", "request_id": "retrieval-part2-lean-20261110-small_lean-gpt-oss-120b-Q2", "start_time": "2026-11-10T18:25:20.113+00:00", "degraded": false, "reply": {"request_id": "retrieval-part2-lean-20261110-small_lean-gpt-oss-120b-Q2", "question": "Why use several attention heads instead of one, and what configuration did the paper use?", "kind": "answer", "level": 0, "text": "Multiple attention heads allow the model to attend to different representation sub‑spaces simultaneously, so each head can focus on distinct linguistic patterns such as anaphora resolution or long‑distance dependencies rather than a single head trying to capture all relations at once[S2]. By running several attention layers in parallel the Transformer can learn diverse tasks within the same layer, which improves its expressive power[S1]. The paper therefore adopts eight parallel attention heads (h = 8), each with dimensionalities d_k = d_v = d_model / h = 64, keeping the overall computational cost comparable to a single full‑dimensional attention head[S3].", "sources": [{"sid": "S1", "cite": "1706.03762v7 pp.3-4 §3.2", "pid": "attention:600:0019", "paper": "attention", "block_ids": ["attention-p03-b007", "attention-p04-b001", "attention-p04-b002", "attention-p04-b003"]}, {"sid": "S2", "cite": "1706.03762v7 pp.14-15 Attention Visualizations (appendix)", "pid": "attention:600:0066", "paper": "attention", "block_ids": ["attention-p14-b001", "attention-p15-b001"]}, {"sid": "S3", "cite": "1706.03762v7 p.5 §3.2.2", "pid": "attention:600:0025", "paper": "attention", "block_ids": ["attention-p05-b006"]}, {"sid": "S4", "cite": "1706.03762v7 p.13 Attention Visualizations (appendix)", "pid": "attention:600:0065", "paper": "attention", "block_ids": ["attention-p13-b002"]}], "notice": "checked for citations only (no second-model check)", "eta_s": null, "model_calls": [{"step": "draft", "model": "openai/gpt-oss-120b", "status": 200, "outcome": "ok", "prompt_tokens": 711, "completion_tokens": 218, "tokens_estimated": false, "ms": 1062.5287000002572, "waited_s": 6.5}], "spans": [{"name": "plan", "start_ms": 0.0, "end_ms": 0.9, "model": null, "outcome": "full", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 6.492421446993831}}, "drafter": "openai/gpt-oss-120b"}}, {"name": "understand", "start_ms": 0.9, "end_ms": 0.9, "model": null, "outcome": "off (config)", "detail": {}}, {"name": "retrieve", "start_ms": 0.9, "end_ms": 1.7, "model": null, "outcome": "1 search", "detail": {"query": "Why use several attention heads instead of one, and what configuration did the paper use?", "papers": null, "k": 4, "evidence": {"best": 0.496, "union": 0.496, "top_bm25": 12.418, "query_terms": 6}}}, {"name": "decide", "start_ms": 1.7, "end_ms": 1.8, "model": null, "outcome": "draft", "detail": {"best": 0.496, "union": 0.496, "top_bm25": 12.418, "query_terms": 6}}, {"name": "draft", "start_ms": 1.8, "end_ms": 7566.9, "model": null, "outcome": "openai/gpt-oss-120b", "detail": {"level": "full"}}, {"name": "wait:draft", "start_ms": 1.8, "end_ms": 6502.4, "model": "openai/gpt-oss-120b", "outcome": "granted", "detail": {"waited_s": 6.5}}, {"name": "call:draft", "start_ms": 6502.4, "end_ms": 7566.9, "model": "openai/gpt-oss-120b", "outcome": "200:ok", "detail": {}}, {"name": "check", "start_ms": 7567.0, "end_ms": 7567.4, "model": null, "outcome": "pass", "detail": {"gate_ok": true, "failures": 0, "verifier": null}}, {"name": "verify", "start_ms": 7567.4, "end_ms": 7567.4, "model": null, "outcome": "off (config)", "detail": {}}, {"name": "send", "start_ms": 7567.4, "end_ms": 7567.4, "model": null, "outcome": "answer", "detail": {}}], "checks": {"gate": {"ok": true, "sentences": 3, "failures": []}, "verifier": null, "draft_model": "openai