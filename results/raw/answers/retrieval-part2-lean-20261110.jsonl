{"type": "answer", "run_id": "retrieval-part2-lean-20261110", "scenario": "eval:retrieval", "source": "real", "setting": "small_lean", "setting_def": {"piece_chars": 600, "k": 4, "rerank": false, "router": false}, "drafter": "openai/gpt-oss-120b", "qid": "Q7", "request_id": "retrieval-part2-lean-20261110-small_lean-gpt-oss-120b-Q7", "start_time": "2026-11-10T18:25:54.588+00:00", "degraded": false, "reply": {"request_id": "retrieval-part2-lean-20261110-small_lean-gpt-oss-120b-Q7", "question": "Why do the authors say traditional spoken dialogue systems struggle to feel natural?", "kind": "answer", "level": 0, "text": "Traditional spoken dialogue systems are built as pipelines of independent components—voice activity detection, speech recognition, textual dialogue processing, and text‑to‑speech—rather than as an integrated model [S3]. This modular architecture introduces a latency of several seconds between user utterances and system responses, disrupting the natural flow of conversation [S2]. Because text is used as the intermediate modality, non‑linguistic information that modifies meaning, such as emotion or non‑speech sounds, is lost in the interaction [S2]. The combination of high latency and loss of expressive cues prevents these systems from emulating the experience of real, fluid conversations [S2].", "sources": [{"sid": "S1", "cite": "2410.00037v1 p.2 §1", "pid": "moshi:600:0005", "paper": "moshi", "block_ids": ["moshi-p02-b002"]}, {"sid": "S2", "cite": "2410.00037v1 p.1 Abstract", "pid": "moshi:600:0000", "paper": "moshi", "block_ids": ["moshi-p01-b005"]}, {"sid": "S3", "cite": "2410.00037v1 p.2 §1", "pid": "moshi:600:0003", "paper": "moshi", "block_ids": ["moshi-p02-b002"]}, {"sid": "S4", "cite": "2410.00037v1 p.30 §5.5", "pid": "moshi:600:0173", "paper": "moshi", "block_ids": ["moshi-p30-b001", "moshi-p30-b002"]}], "notice": "checked for citations only (no second-model check)", "eta_s": null, "model_calls": [{"step": "draft", "model": "openai/gpt-oss-120b",