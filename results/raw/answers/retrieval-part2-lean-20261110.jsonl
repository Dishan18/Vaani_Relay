{"type": "answer", "run_id": "retrieval-part2-lean-20261110", "scenario": "eval:retrieval", "source": "real", "setting": "small_lean", "setting_def": {"piece_chars": 600, "k": 4, "rerank": false, "router": false}, "drafter": "openai/gpt-oss-120b", "qid": "Q9", "request_id": "retrieval-part2-lean-20261110-small_lean-gpt-oss-120b-Q9", "start_time": "2026-11-10T18:26:15.778+00:00", "degraded": false, "reply": {"request_id": "retrieval-part2-lean-20261110-small_lean-gpt-oss-120b-Q9", "question": "What makes Moshi full-duplex, and how does it handle both sides speaking at once?", "kind": "answer", "level": 0, "text": "Moshi is built as a multi‑stream speech‑to‑speech Transformer that processes two separate streams of semantic and acoustic tokens—one for the user and one for the model—allowing it to listen and speak simultaneously, which is the core of its full‑duplex capability[S4]. By hierarchically generating these token streams in parallel and time‑aligning them, Moshi can produce its own speech while continuously receiving the user’s input without a fixed turn‑taking boundary[S3]. This architecture lets the system always be ready to listen and to speak at any moment, enabling true full‑duplex spoken dialogue[S1].", "sources": [{"sid": "S1", "cite": "2410.00037v1 p.5 §2", "pid": "moshi:600:0032", "paper": "moshi", "block_ids": ["moshi-p05-b002"]}, {"sid": "S2", "cite": "2410.00037v1 p.5 §2", "pid": "moshi:600:0033", "paper": "moshi", "block_ids": ["moshi-p05-b002"]}, {"sid": "S3", "cite": "2410.00037v1 p.6 §2", "pid": "moshi:600:0034", "paper": "moshi", "block_ids": ["moshi-p06-b001", "moshi-p06-b002"]}, {"sid": "S4", "cite": "2410.00037v1 p.6 §3.1", "pid": "moshi:600:0035", "paper": "moshi", "block_ids": ["moshi-p06-b005"]}], "notice": "checked for citations only (no second-model check)", "eta_s": null, "model_calls": [{"step": "draft", "model": "openai/gpt-oss-120b", "status": 200, "outcome": "ok", "prompt_tokens": 1026, "completion_tokens": 212, "tokens_estimated":