{"type": "answer", "run_id": "retrieval-part2-lean-rest-key1b-20261111", "scenario": "eval:retrieval", "source": "real", "setting": "small_lean", "setting_def": {"piece_chars": 600, "k": 4, "rerank": false, "router": false}, "drafter": "openai/gpt-oss-120b", "qid": "Q14", "request_id": "retrieval-part2-lean-rest-key1b-20261111-small_lean-gpt-oss-120b-Q14", "start_time": "2026-11-11T07:24:15.840+00:00", "degraded": false, "reply": {"request_id": "retrieval-part2-lean-rest-key1b-20261111-small_lean-gpt-oss-120b-Q14", "question": "How does H-Net decide where to cut the byte stream into pieces?", "kind": "answer", "level": 0, "text": "At inference time H‑Net evaluates each incoming byte (treated as a token) and predicts, for that token, how much computation it should receive; tokens that merit more processing trigger the start of a new chunk while others are grouped into larger blocks [S2]. This per‑token compute budget is learned jointly with the model so that the network autonomously allocates more compute to “hard” regions of the stream and less to “easy” ones, effectively deciding where to cut the byte stream into chunks [S2]. The resulting chunk boundaries can be visualized as dynamic lines drawn across the byte sequence, illustrating how the model’s learned compute decisions translate into concrete segmentations [S1].", "sources": [{"sid": "S1", "cite": "2507.07955v2 p.14 §3.1", "pid": "dynamic_chunking:600:0103", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p14-b004"]}, {"sid": "S2", "cite": "2507.07955v2 p.10 §2.4", "pid": "dynamic_chunking:600:0075", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p10-b010"]}, {"sid": "S3", "cite": "2507.07955v2 p.12 §3.1", "pid": "dynamic_chunking:600:0093", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p12-b012"]}, {"sid": "S4", "cite": "2507.07955v2 p.16 §3.2", "pid": "dynamic_chunking:600:0111", "paper": "dynamic_chunking", "block_ids": ["dynamic_chunking-p16-b001", "dynamic_chunking-p16-b002"]}], "notice": "checked for citations only (no second-model check)", "eta_s": null, "model_calls": [{"step": "draft", "model": "openai/gpt-oss-120b", "status": 200, "outcome": "ok", "prompt_tokens": 801, "completion_tokens": 215, "tokens_estimated": false, "ms": 1237.5341999995726, "waited_s": 0.0}], "spans": [{"name": "plan", "start_ms": 0.0, "end_ms": 4.0, "model": null, "outcome": "full", "detail": {"predicted_wait_s": {"full": {"openai/gpt-oss-120b": 0.0}}, "drafter": "openai/gpt-oss-120b"}}, {"name": "understand", "start_ms": 4.0, "end_ms": 4.0, "model": null, "outcome": "off (config)", "detail": {}}, {"name": "retrieve", "start_ms": 4.1, "end_ms": 6.9, "model": null, "outcome": "1 search", "detail": {"query": "How does H-Net decide where to cut the byte stream into pieces?", "papers": null, "k": 4, "evidence": {"best": 0.481, "union": 0.6, "top_bm25": 11.813, "query_terms": 7}}}, {"name": "decide", "start_ms": 7.0, "end_ms": 7.1, "model": null, "outcome": "draft", "detail": {"best": 0.481, "union": 0.6, "top_bm25": 11.813, "query_terms": 7}}, {"name": "draft", "start_ms": 7.1, "end_ms": 1248.0, "model": null, "outcome": "openai/gpt-oss-120b", "detail": {"level": "full"}}, {"name": "wait:draft", "start_ms": 7.2, "end_ms": 7.2, "model": "openai/gpt-oss-120b", "outcome": "granted", "detail": {"waited_s": 0.0}}, {"name": "call:draft", "start_ms": 7.3, "end_ms": 1248.0, "model": "openai/gpt-oss-120b", "outcome": "200:ok", "detail": {}}, {"name": "check", "start_ms": 1248.0, "end_ms": 1248.5, "model": null, "outcome": "pass", "detail": {"gate_ok": true, "failures": 0, "verifier": null}}, {"name": "verify", "start_ms": 1248.4, "end_ms": 1248.5, "model": null, "outcome": "off (config)", "detail": {}}, {"name": "send", "start_ms": 1248.5, "end_ms": 1248.5, "model": null, "outcome": "answer", "detail": {}}], "checks": {"gate": {"ok": true, "sentences": 3, "failures": []}, "verifier": null, "draft_model": "openai/gpt-oss-120b", "attempts": 1, "retrieval": {"